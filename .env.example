# Copy to .env (git-ignored) and fill in real values; never commit .env.
# Every variable uses the GUILDHALL_ prefix. Real environment variables
# override values in .env.

# Comma-separated names of the plug-ins to enable.
GUILDHALL_PLUGINS=synthetic

# Password for the local Postgres container in compose.yaml, also used by the
# platform to connect (local only; any value).
GUILDHALL_POSTGRES_PASSWORD=change-me-local-only

# Postgres connection. These default to the compose service; set them only to
# use a different server.
# GUILDHALL_POSTGRES_HOST=127.0.0.1
# GUILDHALL_POSTGRES_PORT=5432
# GUILDHALL_POSTGRES_USER=guildhall
# GUILDHALL_POSTGRES_DB=guildhall

# AWS. Locally these point at the moto service in compose.yaml; any key values
# work with moto. On AWS, leave them unset: the pod's role provides credentials.
GUILDHALL_AWS_ENDPOINT_URL=http://127.0.0.1:5000
GUILDHALL_AWS_ACCESS_KEY_ID=moto-local
GUILDHALL_AWS_SECRET_ACCESS_KEY=moto-local
# Queue settings default to: guildhall-jobs, guildhall-jobs-dlq, 5 receives, 60 s.
# GUILDHALL_JOBS_QUEUE_NAME=guildhall-jobs
# GUILDHALL_DEAD_LETTER_QUEUE_NAME=guildhall-jobs-dlq
# GUILDHALL_MAX_RECEIVE_COUNT=5
# GUILDHALL_VISIBILITY_TIMEOUT_SECONDS=60
# Bucket for raw upstream responses (docs/adr/0031).
# GUILDHALL_ARCHIVE_BUCKET=guildhall-raw

# Upstream calls (docs/adr/0033-0035). Redis holds every plug-in's shared
# budget; when it is unreachable, jobs that call upstream are deferred.
# GUILDHALL_REDIS_URL=redis://127.0.0.1:6379/0
# Per-request timeout, the longest a handler waits for its budget before the
# job is deferred, and how long a 429 without Retry-After pauses the plug-in
# (seconds).
# GUILDHALL_HTTP_TIMEOUT_SECONDS=10
# GUILDHALL_RATE_LIMIT_MAX_WAIT_SECONDS=5
# GUILDHALL_DEFAULT_COOLDOWN_SECONDS=60

# Job runner. Handler timeout plus archive upload timeout stays below the
# visibility timeout; retries back off exponentially with jitter from the base
# delay up to the cap (seconds).
# GUILDHALL_JOB_TIMEOUT_SECONDS=30
# GUILDHALL_ARCHIVE_TIMEOUT_SECONDS=10
# GUILDHALL_RETRY_BASE_SECONDS=20
# GUILDHALL_RETRY_CAP_SECONDS=900

# Outbox relay: rows sent per pass, and how long sent rows are kept (days).
# GUILDHALL_RELAY_BATCH_SIZE=100
# GUILDHALL_OUTBOX_RETENTION_DAYS=7

# Logging. Level is DEBUG, INFO, WARNING or ERROR. Format is json or console;
# unset, it is console on a terminal and JSON everywhere else.
# GUILDHALL_LOG_LEVEL=INFO
# GUILDHALL_LOG_FORMAT=json

# Worker: jobs one worker process runs at once, and how often sent outbox rows
# past their retention are pruned (seconds).
# GUILDHALL_WORKER_CONCURRENCY=10
# GUILDHALL_PRUNE_INTERVAL_SECONDS=3600
# How often each worker looks for due schedule ticks (seconds).
# GUILDHALL_SCHEDULE_INTERVAL_SECONDS=30
# How long one receive waits for messages (long polling, 0 to 20 seconds); a
# stopping worker lets an open receive finish, so this bounds an idle stop.
# GUILDHALL_RECEIVE_WAIT_SECONDS=20
# How long a stopping worker waits for running jobs; keep it above the job
# timeout, and the grace period (compose, Kubernetes) above it plus 5 s.
# GUILDHALL_SHUTDOWN_DRAIN_SECONDS=35

# Discord (docs/adr/0057-0061). The application's public key, from the
# developer portal's General Information page: hex, not a secret, but specific
# to your application, so it lives here rather than in the repo.
GUILDHALL_DISCORD_PUBLIC_KEY=
# Where the api listens (the container sets 0.0.0.0).
# GUILDHALL_API_HOST=127.0.0.1
# GUILDHALL_API_PORT=8000

# The tunnel that lets Discord reach the api (compose profile "tunnel",
# docs/adr/0060). The authtoken is a SECRET, from the ngrok dashboard; the
# domain is your free static one, without https://.
# GUILDHALL_NGROK_AUTHTOKEN=
# GUILDHALL_NGROK_DOMAIN=example-name.ngrok-free.app

# Development only: the Dota account whose latest match scripts/record_opendota.py
# records as test fixtures (docs/development.md). The recorder replaces every
# ID before writing; the bot itself never reads this.
# GUILDHALL_FIXTURE_ACCOUNT_ID=
